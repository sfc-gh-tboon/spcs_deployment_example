<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="SPCS Writeback Deployment" id="spcs-writeback-deployment">
    <mxGraphModel dx="1200" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1740" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="ttl_1" value="SPCS WRITEBACK SERVICE DEPLOYMENT  |  October 2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A3E5C;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=20;fontStyle=1;align=left;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="90" y="30" width="1020" height="58" as="geometry"/></mxCell>
        <mxCell id="c_1" value="01  CONFIGURATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontColor=#1A3E5C;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="900" height="125" as="geometry"/></mxCell>
        <mxCell id="c_2" value="02  INFRASTRUCTURE  |  STEPS 1–5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#1A3E5C;fontColor=#1A3E5C;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="150" y="255" width="900" height="550" as="geometry"/></mxCell>
        <mxCell id="c_3" value="03  BUILD  |  STEPS 6–7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#29B5E8;fontColor=#1A3E5C;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="150" y="825" width="900" height="230" as="geometry"/></mxCell>
        <mxCell id="c_4" value="04  DEPLOY  |  STEPS 8–9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#118FBB;fontColor=#1A3E5C;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="150" y="1075" width="900" height="230" as="geometry"/></mxCell>
        <mxCell id="c_5" value="05  VALIDATION  |  STEP 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#1A3E5C;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="150" y="1325" width="900" height="125" as="geometry"/></mxCell>
        <mxCell id="c_6" value="06  RESULT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontColor=#1A3E5C;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="150" y="1470" width="900" height="135" as="geometry"/></mxCell>
        <mxCell id="s_config" value="&lt;b&gt;config.ps1&lt;/b&gt;&lt;br&gt;Prompts: service name, connection, roles, writeback targets, debug mode&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: configured interactively&lt;/font&gt;" tooltip="Collect deployment configuration before provisioning resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9800;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="145" width="560" height="72" as="geometry"/></mxCell>
        <mxCell id="s_repo" value="&lt;b&gt;Step 1: Create Image Repository&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: ROLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A3E5C;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="290" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="s_pool" value="&lt;b&gt;Step 2: Create Compute Pool + wait for ACTIVE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: ROLE&lt;/font&gt;" tooltip="Continue when the compute pool reaches ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A3E5C;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="400" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="s_network" value="&lt;b&gt;Step 3: Create Network Rule for egress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: ROLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A3E5C;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="510" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="s_secret" value="&lt;b&gt;Step 4: Create Secret&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: ROLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A3E5C;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="620" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="s_eai" value="&lt;b&gt;Step 5: Create External Access Integration&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: ADMIN_ROLE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A3E5C;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="730" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="s_build" value="&lt;b&gt;Step 6: Docker Build (linux/amd64)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: local Docker environment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#29B5E8;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="860" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="s_push" value="&lt;b&gt;Step 7: Push Image to Snowflake Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: registry-authenticated connection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#29B5E8;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="970" width="560" height="60" as="geometry"/></mxCell>
        <mxCell id="s_service" value="&lt;b&gt;Step 8: Create SPCS Service&lt;/b&gt;&lt;br&gt;Substitute template placeholders; generate service.yaml&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: SERVICE_ROLE&lt;/font&gt;" tooltip="Generate service.yaml from the service specification template" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#118FBB;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1105" width="560" height="72" as="geometry"/></mxCell>
        <mxCell id="s_function" value="&lt;b&gt;Step 9: Wait for READY, Create Service Function&lt;/b&gt;&lt;br&gt;Grant to SERVICE_ROLE&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: ROLE&lt;/font&gt;" tooltip="Continue when the service reaches READY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#118FBB;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1215" width="560" height="72" as="geometry"/></mxCell>
        <mxCell id="s_tests" value="&lt;b&gt;Step 10: Run Tests&lt;/b&gt;&lt;br&gt;Missing productCode · valid productCode · batch&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: configured test connection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1360" width="560" height="72" as="geometry"/></mxCell>
        <mxCell id="s_live" value="&lt;b&gt;Service Live&lt;/b&gt;&lt;br&gt;&lt;code&gt;SELECT ROUTE_&amp;lt;NAME&amp;gt;_WRITEBACK(...);&lt;/code&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Role: SERVICE_ROLE (granted usage)&lt;/font&gt;" tooltip="Invoke the deployed writeback service function from SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4CAF50;strokeColor=#1A3E5C;fontColor=#FFFFFF;fontSize=14;arcSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="1510" width="560" height="78" as="geometry"/></mxCell>
        <mxCell id="fl_1" value="configure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_config" target="s_repo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_2" value="provision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_repo" target="s_pool" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_3" value="ACTIVE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_pool" target="s_network" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_4" value="configure egress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_network" target="s_secret" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_5" value="authorize" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_secret" target="s_eai" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_6" value="build" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_eai" target="s_build" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_7" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_build" target="s_push" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_8" value="deploy image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_push" target="s_service" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_9" value="READY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_service" target="s_function" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_10" value="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1A3E5C;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_function" target="s_tests" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fl_11" value="tests pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4CAF50;strokeWidth=2;fontColor=#1A3E5C;fontSize=11;" edge="1" source="s_tests" target="s_live" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="leg_1" value="&lt;b&gt;LEGEND&lt;/b&gt;&lt;br&gt;Orange: configuration&lt;br&gt;Dark blue: infrastructure&lt;br&gt;Blue: build / deploy&lt;br&gt;Green: validation / live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#1A3E5C;fontColor=#1A3E5C;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="1620" width="290" height="98" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
